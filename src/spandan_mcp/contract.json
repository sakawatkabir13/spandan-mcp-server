    {
      "name": "propose_create_session",
      "description": "Prepare a single session at an existing authorized chamber. Times are Asia/Dhaka local time.",
      "roles": [
        "doctor",
        "assistant",
        "administrator"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "chamber_id": {
            "type": "string",
            "maxLength": 200,
            "format": "uuid"
          },
          "schedule_date": {
            "type": "string",
            "maxLength": 200,
            "format": "date"
          },
          "start_time": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
          },
          "end_time": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
          },
          "maximum_patients": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "average_consultation_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240
          }
        },
        "required": [
          "chamber_id",
          "schedule_date",
          "start_time",
          "end_time",
          "maximum_patients"
        ],
        "additionalProperties": false
      },
      "sensitive": false
    },
    {
      "name": "propose_update_session",
