MCP_ENV=development
MCP_API_BASE_URL=http://127.0.0.1:8000/api/v1/internal/chat-tools
MCP_SERVICE_TOKEN=replace-with-private-shared-service-token-at-least-32-characters
MCP_PUBLIC_KEY="replace-with-Spandan-Ed25519-public-key-PEM"
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production; mount read-only private files.
MCP_TLS_CA=
MCP_TLS_CERT=
MCP_TLS_KEY=
